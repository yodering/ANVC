{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "anvc",
  "version": "0.4.2",
  "identifier": "com.anvc.worklog",
  "build": {
    "frontendDist": "../desktop",
    "beforeDevCommand": "bun scripts/desktop-sidecar.ts",
    "beforeBuildCommand": "bun scripts/desktop-sidecar.ts"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "anvc",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/anvc-server"
    ]
  }
}
